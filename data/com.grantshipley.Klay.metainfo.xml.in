<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>@APP_NAME@</name>
  <summary>Launch all your games</summary>
  <developer id="com.grantshipley">
    <name>Klay Contributors</name>
  </developer>
  <url type="homepage">https://github.com/gshipley/Klay</url>
  <description>
    <p>@APP_NAME@ is a KDE-focused game launcher that brings titles from Steam, Heroic, Lutris,
    Bottles, RetroArch, and more into one fast library so you can browse, search, and start
    your games from a single polished desktop experience.</p>
  </description>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <translation type="gettext">@GETTEXT_DOMAIN@</translation>
  <content_rating type="oars-1.1" />
</component>
